<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💀 BSOD TESTER 💀"
        android:textSize="28sp"
        android:textColor="#FF0000"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvRootStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checking root..."
        android:textSize="14sp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnBSOD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💀 TRIGGER FULL BSOD 💀"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="#D32F2F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="15dp"
        android:padding="15dp"/>

    <Button
        android:id="@+id/btnSoftFreeze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ SOFT FREEZE (Test) ⚠️"
        android:textSize="16sp"
        android:background="#FF9800"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="15dp"
        android:padding="15dp"/>

    <Button
        android:id="@+id/btnSafeMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔧 REBOOT TO SAFE MODE 🔧"
        android:textSize="16sp"
        android:background="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="25dp"
        android:padding="15dp"/>

    <TextView
        android:id="@+id/tvInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instructions will appear here"
        android:textSize="12sp"
        android:textColor="#CCCCCC"
        android:background="#2C2C2C"
        android:padding="15dp"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>