<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textStyle="bold"
            android:textSize="20sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_placeholder"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/warning"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/expected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expected_bsod"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timer_initial"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Tips:\n• This runs automatically on open.\n• To recover: press Back (stops and exits).\n• If it fully freezes, wait 15–30 seconds or hold Power to reboot.\n• Safe Mode should disable this app and symptoms should improve." />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/blue_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lab_blue"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blue_title"
            android:textColor="@color/lab_blue_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/blue_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_placeholder"
            android:textColor="@color/lab_blue_text"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/blue_working"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/working"
            android:textColor="@color/lab_blue_text"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/blue_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timer_initial"
            android:textColor="@color/lab_blue_text"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blue_body"
            android:textColor="@color/lab_blue_text"
            android:paddingBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blue_exit_hint"
            android:textColor="@color/lab_blue_text"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
